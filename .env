# .env
# Application settings
APP_NAME=Smart Web Scraper API
APP_VERSION=1.0.0
DEBUG=True

# PostgreSQL credentials (used by the `database` service and to build DATABASE_URL)
POSTGRES_USER=scraper_user
POSTGRES_PASSWORD=scraper_password
POSTGRES_DB=scraper_db
POSTGRES_HOST=database
POSTGRES_PORT=5432

# Full SQLAlchemy connection string used by the app.
# docker-compose.yml overrides this to point at the `database` service;
# for running the API locally without Docker, use localhost instead:
# DATABASE_URL=postgresql+psycopg2://scraper_user:scraper_password@localhost:5432/scraper_db
DATABASE_URL=postgresql+psycopg2://scraper_user:scraper_password@database:5432/scraper_db

# Scraper settings
REQUEST_TIMEOUT=10
CONNECT_TIMEOUT=5
READ_TIMEOUT=15
MAX_RETRIES=3
BACKOFF_FACTOR=0.5
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36